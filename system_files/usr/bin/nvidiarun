#!/usr/bin/env bash
# nvidiarun — jalankan app apa pun di GPU NVIDIA (PRIME render offload).
#   nvidiarun <app>            → offload polos (OBS, editor, Blender, dll)
#   nvidiarun --game <cmd>     → game: NVIDIA + GameMode (+ MangoHud),
#                                GameMode/MangoHud saja.
#
# Default sesi tetap di AMD iGPU (hemat daya, dGPU tidur D3).
# Steam Launch Options: nvidiarun --game %command%
set -euo pipefail

export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export GBM_BACKEND=nvidia-drm
export __VK_LAYER_NV_optimus=NVIDIA_only

if [[ "${1:-}" == "--game" ]]; then
    shift
    export MANGOHUD_DLSYM=1
    _args=(gamemoderun)
    if command -v mangohud >/dev/null 2>&1; then
        _args+=(mangohud)
    fi

    exec "${_args[@]}" "$@"
fi

exec "$@"