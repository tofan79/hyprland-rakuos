#!/bin/bash
# fwupdmgr version shim.
#
# Some applications report the firmware-update client version in their UI or
# diagnostics by calling `fwupdmgr --version`. RakuOS ships no firmware client
# version that third-party software maps cleanly, so this wrapper lies about
# the version string (9.99.999, a deliberately-high fake) to satisfy those
# checks — while still forwarding every real invocation to the actual
# /usr/bin/fwupdmgr unchanged. Update the fake number if a tool starts
# rejecting it.
if [ "$1" = "--version" ]; then
    echo "client version: 9.99.999"
    exit 0
fi
exec /usr/bin/fwupdmgr "$@"