{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/rakuos.png",
    "width": 30,
    "height": 17,
    "padding": {
      "top": 7,
      "right": 4,
      "left": 3
    },
    "color": {
      "1": "#63c2ff",
      "2": "#63c4dd"
    }
  },
  "display": {
    "color": {
      "keys": "#bdc2ff",
      "title": "#c4c4dd"
    },
    "key": {
      "width": 10
    },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": {
        "green": "#e7b9d5",
        "yellow": "#bdc2ff",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "\u001b[1;38;2;243;237;225m{user-name}\u001b[0m\u001b[38;2;143;135;112m @ \u001b[0m\u001b[1;38;2;243;237;225m{host-name}\u001b[0m"
    },
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh brand"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh DEVICE"
    },
    {
      "type": "host",
      "key": "HOST"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci",
      "format": "{vendor} {name}"
    },
    {
      "type": "display",
      "key": "DISPLAY"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "swap",
      "key": "SWAP"
    },
    {
      "type": "disk",
      "key": "DISK"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh SYSTEM"
    },
    {
      "type": "command",
      "key": "OS",
      "text": ". /etc/os-release && echo \"$PRETTY_NAME x86_64\""
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "command",
      "key": "WM",
      "text": "echo \"${XDG_CURRENT_DESKTOP:-Hyprland}\""
    },
    {
      "type": "command",
      "key": "SHELL",
      "text": "basename \"${SHELL:-unknown}\""
    },
    {
      "type": "command",
      "key": "NOCTALIA",
      "text": "rpm -q --qf '%{VERSION}' noctalia-git 2>/dev/null || echo unknown"
    },
    {
      "type": "terminal",
      "key": "TERM"
    },
    {
      "type": "command",
      "key": "FONT",
      "text": "f=$(awk -F'\\\"' '/^font-family/ {print $2}' ~/.config/ghostty/config.ghostty 2>/dev/null); s=$(awk '/^font-size/ {print $3}' ~/.config/ghostty/config.ghostty 2>/dev/null); [ -n \"$f\" ] && fc-match \"$f\" -f \"$f (%{style}) - $s pt\" || echo \"default - $s pt\""
    },
    {
      "type": "packages",
      "key": "PKGS"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "bash ~/.config/fastfetch/noctalia-header.sh SESSION"
    },
    {
      "type": "command",
      "key": "AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /etc/machine-id)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
